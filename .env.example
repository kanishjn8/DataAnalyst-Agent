# Run python3 scripts/local_setup.py to generate the real root .env.
# Keep the generated credentials when reusing existing Docker volumes.
POSTGRES_PASSWORD=generated-by-local-setup
# Local HS256 signing secret. Hosted ES256/RS256 verification uses public JWKS instead.
JWT_SECRET=generated-by-local-setup
ANON_KEY=generated-by-local-setup
SERVICE_ROLE_KEY=generated-by-local-setup
# Local project URL. Compose supplies its own backend service configuration.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# Backend only. After editing, run docker compose up -d --force-recreate backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Backend only. Compose uses its internal redis hostname automatically.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=data-analysis:v1
# On Railway, set REDIS_URL to Upstash's TLS Redis connection string:
# rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379
# Optional when building a separately hosted frontend:
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com

# Hosted backend settings: add these in Render/Railway, using cloud credentials.
# Keep the local .env above for Docker Compose.
# SUPABASE_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1
# STORAGE_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1
# STORAGE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# DATABASE_URL=postgresql://analysis_app.YOUR_PROJECT_REF:ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379
# REDIS_NAMESPACE=data-analysis:production
# JWT_SECRET is optional for hosted ES256/RS256 projects; keep it for local HS256.
# JWT_ISSUER defaults to SUPABASE_PUBLIC_URL + /auth/v1 when not set.
# The current storage adapter expects a legacy service_role JWT, not an sb_secret key.
